<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Dashboard — EliteHost</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .tab-content { display: none; padding: 20px; animation: slideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
    .tab-content.active { display: block; }
    @keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .status-badge { padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 800; text-transform: uppercase; border: 1px solid currentColor; }
    .status-running { color: #ffffff; background: rgba(255,255,255,0.1); }
    .status-stopped { color: #888888; background: rgba(255,255,255,0.05); }
    .status-failed { color: #ff4444; background: rgba(255,68,68,0.1); }

    .terminal { background: #000; border: 1px solid var(--border); border-radius: 12px; padding: 16px; font-family: 'JetBrains Mono', monospace; font-size: 12px; height: 350px; overflow-y: auto; color: #a0a0a0; box-shadow: inset 0 0 20px rgba(0,0,0,0.5); }

    /* App-like feel */
    body { padding-bottom: 120px; }
    .header-compact { height: 60px; padding: 0 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(20px); z-index: 100; }
  </style>
</head>
<body>
  <div class="header-compact">
    <div class="logo-container" style="display: flex; align-items: center; gap: 10px;">
      <div class="logo-square" style="width: 28px; height: 28px; font-size: 16px;">E</div>
      <div class="brand-name" style="font-size: 18px;">ELITE</div>
    </div>
    <div id="userInitials" class="logo-square" style="width: 32px; height: 32px; border-radius: 50%; background: #fff; color: #000; cursor: pointer; font-size: 14px;">U</div>
  </div>

  <main>
    <!-- HOME TAB -->
    <div id="home" class="tab-content active">
      <h2 id="greeting" style="font-weight: 900; font-size: 28px; letter-spacing: -0.02em;">Welcome, Elite.</h2>
      <div class="grid-3 mt-4" style="grid-template-columns: repeat(2, 1fr); gap: 12px;">
        <div class="glass-card">
          <div class="text-muted" style="font-size: 10px; font-weight: 800; letter-spacing: 0.1em;">ACTIVE SYSTEMS</div>
          <div id="activeBotsCount" style="font-size: 28px; font-weight: 900;">0</div>
        </div>
        <div class="glass-card">
          <div class="text-muted" style="font-size: 10px; font-weight: 800; letter-spacing: 0.1em;">WALLET TOTAL</div>
          <div id="walletBalance" style="font-size: 28px; font-weight: 900;">₹0</div>
        </div>
      </div>

      <h3 style="margin: 32px 0 16px; font-size: 14px; font-weight: 800; text-transform: uppercase; color: var(--text-muted);">Quick Commands</h3>
      <div style="display: flex; gap: 12px;">
        <button class="btn btn-primary" style="flex: 1;" onclick="switchTab('deploy')">Deploy New</button>
        <button class="btn btn-outline" style="flex: 1;" onclick="switchTab('wallet')">Add Credits</button>
      </div>

      <h3 style="margin: 32px 0 16px; font-size: 14px; font-weight: 800; text-transform: uppercase; color: var(--text-muted);">Live Deployments</h3>
      <div id="recentDeployments">
        <div class="glass-card" style="text-align: center; padding: 40px 20px;">
             <div class="text-muted">No active deployments found.</div>
        </div>
      </div>
    </div>

    <!-- MANAGE TAB -->
    <div id="manage" class="tab-content">
      <h2 style="font-weight: 900; font-size: 28px;">Management</h2>
      <div id="deploymentList" class="mt-4">
        <!-- Deployment cards -->
      </div>
    </div>

    <!-- DEPLOY TAB -->
    <div id="deploy" class="tab-content">
      <h2 style="font-weight: 900; font-size: 28px;">New Deployment</h2>
      <div style="display: flex; gap: 10px; margin: 24px 0;">
        <button id="btnGit" class="btn btn-primary" style="flex: 1;" onclick="setDeployMode('github')">GITHUB</button>
        <button id="btnZip" class="btn btn-outline" style="flex: 1;" onclick="setDeployMode('zip')">ZIP</button>
      </div>

      <div id="gitForm">
        <div class="input-group">
          <label>Repository URL</label>
          <input type="text" id="gitRepo" placeholder="https://github.com/elite/bot">
        </div>
        <div class="input-group">
          <label>Branch</label>
          <input type="text" id="gitBranch" value="main">
        </div>
      </div>

      <div id="zipForm" style="display: none;">
        <div class="input-group">
          <label>Source Bundle (ZIP)</label>
          <input type="file" id="zipFile" accept=".zip">
        </div>
      </div>

      <div class="input-group">
        <label>System Name</label>
        <input type="text" id="deployName" placeholder="elite-production-v1">
      </div>

      <button class="btn btn-primary" style="width: 100%; margin-top: 12px; height: 56px; font-size: 16px;" onclick="startDeploy()">EXECUTE DEPLOYMENT</button>

      <div id="deployProgress" class="mt-4" style="display: none;">
        <div class="terminal mt-2" id="deployLogs"></div>
      </div>
    </div>

    <!-- AI TAB -->
    <div id="ai" class="tab-content">
       <div style="text-align: center; padding: 80px 20px;">
          <div style="font-size: 80px; margin-bottom: 24px; filter: grayscale(1);">🤖</div>
          <h2 style="font-weight: 900;">AI NEURAL CORE</h2>
          <p class="text-muted" style="margin-top: 12px;">The elite intelligence is being calibrated. Access will be granted soon.</p>
       </div>
    </div>

    <!-- SETTINGS TAB -->
    <div id="settings" class="tab-content">
      <h2 style="font-weight: 900; font-size: 28px;">Settings</h2>
      <div class="glass-card mt-4">
        <h3 style="font-size: 16px; font-weight: 800;">Referral Network</h3>
        <p class="text-muted" style="margin-top: 8px;">Earn 30% of all payments from your recruits.</p>
        <div class="input-group mt-4">
          <label>Identification Code</label>
          <div style="display: flex; gap: 8px;">
            <input type="text" id="refCode" readonly style="font-family: monospace;">
            <button class="btn btn-outline" style="padding: 0 20px;" onclick="copyRef()">COPY</button>
          </div>
        </div>
      </div>

      <button class="btn btn-outline mt-4" style="width: 100%; color: #ff4444; border-color: #ff4444;" onclick="logout()">TERMINATE SESSION</button>
    </div>
  </main>

  <nav class="bottom-nav">
    <div class="nav-item active" onclick="switchTab('home')">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
      <span>HOME</span>
    </div>
    <div class="nav-item" onclick="switchTab('manage')">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
      <span>MANAGE</span>
    </div>
    <div class="nav-item" onclick="switchTab('deploy')">
      <div style="width: 48px; height: 48px; background: #fff; color: #000; border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 4px; box-shadow: 0 4px 15px rgba(255,255,255,0.3);">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg>
      </div>
    </div>
    <div class="nav-item" onclick="switchTab('ai')">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8z"></path><path d="M12 6a6 6 0 1 0 6 6 6 6 0 0 0-6-6zm0 10a4 4 0 1 1 4-4 4 4 0 0 1-4 4z"></path></svg>
      <span>AI</span>
    </div>
    <div class="nav-item" onclick="switchTab('settings')">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      <span>SYSTEM</span>
    </div>
  </nav>

  <script src="/js/dashboard.js"></script>
  <script>
    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');

      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      const activeNav = Array.from(document.querySelectorAll('.nav-item')).find(n => n.innerText.toLowerCase().includes(tabId) || (tabId === 'deploy' && n.querySelector('div')));
      if (activeNav) activeNav.classList.add('active');

      window.scrollTo(0, 0);
    }
  </script>
</body>
</html>
