<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — EliteHost</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .tab-content { display: none; padding: 20px; animation: fadeIn 0.3s; }
    .tab-content.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    .status-badge { padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: 700; text-transform: uppercase; }
    .status-running { background: rgba(16, 185, 129, 0.1); color: var(--success); }
    .status-stopped { background: rgba(245, 158, 11, 0.1); color: var(--warning); }
    .status-failed { background: rgba(239, 68, 68, 0.1); color: var(--error); }

    .terminal { background: #0A0A0F; border: 1px solid var(--border); border-radius: 8px; padding: 16px; font-family: 'JetBrains Mono', monospace; font-size: 12px; height: 300px; overflow-y: auto; color: #94A3B8; }
    .terminal .success { color: var(--success); }
    .terminal .error { color: var(--error); }
    .terminal .info { color: var(--accent); }
  </style>
</head>
<body>
  <header class="main-header">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
      <div class="logo-container">
        <div class="logo-square" style="width: 24px; height: 24px; font-size: 14px;">E</div>
        <div class="brand-name" style="font-size: 16px;">Elite<span>Host</span></div>
      </div>
      <div style="display: flex; align-items: center; gap: 16px;">
        <div id="userInitials" class="logo-square" style="width: 32px; height: 32px; border-radius: 50%; cursor: pointer;">U</div>
      </div>
    </div>
  </header>

  <main style="padding-top: 64px; padding-bottom: 80px;">
    <!-- HOME TAB -->
    <div id="home" class="tab-content active">
      <h2 id="greeting">Good morning, User 👋</h2>
      <div class="grid-3 mt-4" style="grid-template-columns: repeat(2, 1fr); gap: 16px;">
        <div class="glass-card">
          <div class="text-secondary" style="font-size: 11px;">ACTIVE BOTS</div>
          <div id="activeBotsCount" style="font-size: 24px; font-weight: 700;">0</div>
        </div>
        <div class="glass-card">
          <div class="text-secondary" style="font-size: 11px;">WALLET BALANCE</div>
          <div id="walletBalance" style="font-size: 24px; font-weight: 700;">₹0</div>
        </div>
      </div>

      <h3 class="mt-4 mb-4">Quick Actions</h3>
      <div style="display: flex; gap: 12px; overflow-x: auto; padding-bottom: 10px;">
        <button class="btn btn-primary" onclick="switchTab('deploy')">+ New Deploy</button>
        <button class="btn btn-outline" onclick="switchTab('wallet')">Add Money</button>
      </div>

      <h3 class="mt-4 mb-4">Recent Deployments</h3>
      <div id="recentDeployments">
        <p class="text-muted">No deployments yet.</p>
      </div>
    </div>

    <!-- MANAGE TAB -->
    <div id="manage" class="tab-content">
      <h2>Your Deployments</h2>
      <div id="deploymentList" class="mt-4">
        <!-- Deployment cards go here -->
      </div>
    </div>

    <!-- DEPLOY TAB -->
    <div id="deploy" class="tab-content">
      <h2>Deploy New Bot</h2>
      <div style="display: flex; gap: 10px; margin: 20px 0;">
        <button id="btnGit" class="btn btn-primary" style="flex: 1;" onclick="setDeployMode('github')">GitHub</button>
        <button id="btnZip" class="btn btn-outline" style="flex: 1;" onclick="setDeployMode('zip')">ZIP Upload</button>
      </div>

      <div id="gitForm">
        <div class="input-group">
          <label>Repository URL</label>
          <input type="text" id="gitRepo" placeholder="https://github.com/user/repo">
        </div>
        <div class="input-group">
          <label>Branch</label>
          <input type="text" id="gitBranch" value="main">
        </div>
      </div>

      <div id="zipForm" style="display: none;">
        <div class="input-group">
          <label>ZIP File</label>
          <input type="file" id="zipFile" accept=".zip">
        </div>
      </div>

      <div class="input-group">
        <label>Deployment Name</label>
        <input type="text" id="deployName" placeholder="My Awesome Bot">
      </div>

      <details class="mb-4">
        <summary style="cursor: pointer; color: var(--accent); font-weight: 600;">Advanced Configuration</summary>
        <div class="mt-4">
          <div class="input-group">
            <label>Build Command (optional)</label>
            <input type="text" id="buildCmd" placeholder="pip install -r requirements.txt">
          </div>
          <div class="input-group">
            <label>Run Command (optional)</label>
            <input type="text" id="runCmd" placeholder="python3 main.py">
          </div>
        </div>
      </details>

      <button class="btn btn-primary" style="width: 100%;" onclick="startDeploy()">🚀 Deploy Now</button>

      <div id="deployProgress" class="mt-4" style="display: none;">
        <h3>Deployment Logs</h3>
        <div id="deployLogs" class="terminal mt-2"></div>
      </div>
    </div>

    <!-- AI TAB -->
    <div id="ai" class="tab-content">
       <div style="text-align: center; padding: 60px 20px;">
          <div style="font-size: 64px; margin-bottom: 24px;">🤖</div>
          <h2 style="font-size: 24px; margin-bottom: 16px;">AI Assistant — Coming Soon</h2>
          <p class="text-secondary">We're building an AI that will help you write, debug, and optimize your bot code automatically.</p>
          <button class="btn btn-primary mt-4">Notify Me</button>
       </div>
    </div>

    <!-- SETTINGS TAB -->
    <div id="settings" class="tab-content">
      <h2>Settings</h2>
      <div class="glass-card mt-4">
        <h3>Referral Program</h3>
        <p class="text-secondary mt-2">Earn 30% for every purchase.</p>
        <div class="input-group mt-4">
          <label>Your Referral Code</label>
          <div style="display: flex; gap: 8px;">
            <input type="text" id="refCode" readonly>
            <button class="btn btn-outline" onclick="copyRef()">Copy</button>
          </div>
        </div>
      </div>

      <button class="btn btn-outline mt-4" style="width: 100%; color: var(--error); border-color: var(--error);" onclick="logout()">Logout</button>
    </div>
  </main>

  <nav class="bottom-nav">
    <div class="nav-item active" onclick="switchTab('home')">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
      <span>Home</span>
    </div>
    <div class="nav-item" onclick="switchTab('manage')">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
      <span>Manage</span>
    </div>
    <div class="nav-item" onclick="switchTab('deploy')">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg>
      <span>Deploy</span>
    </div>
    <div class="nav-item" onclick="switchTab('ai')">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path></svg>
      <span>AI</span>
    </div>
    <div class="nav-item" onclick="switchTab('settings')">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
      <span>Settings</span>
    </div>
  </nav>

  <script src="/js/dashboard.js"></script>
</body>
</html>
